// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./lib/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String      @id @default(cuid())
  titulo    String
  corpo     String
  imagens   String?  // Opcional (caso um post não tenha imagem)
  projetoId String      @map("projeto") // Mapeia a coluna 'projeto' do banco para 'projetoId' no código
  status    String
  postadoEm DateTime @default(now()) @map("postado_em")

  // Relação: Um Post pertence a um Projeto
  projeto   Projeto  @relation(fields: [projetoId], references: [id])

  @@map("posts") // Garante que a tabela no PostgreSQL se chamará 'posts'
}

model Projeto {
  id                 String                @id @default(cuid())
  nome               String
  descricao          String?
  foto               String?            // Opcional
  banner             String?            // Opcional
  contato            String?            // Opcional
  descricaoCurta    String                @default("Descrição curta")
  
  // Relações reversas (Um projeto tem vários posts, membros, etc.)
  posts              Post[]
  membros            Membro[]
  processosSeletivos ProcessoSeletivo[]
  eventos            Evento[]

  @@map("projeto")
}

model Usuario {
  id      String      @id @default(cuid())
  RA      Int
  nome    String
  
  // Relação reversa com a tabela pivot de membros
  membros Membro[]

  @@map("usuario")
}

// Tabela pivot (Many-to-Many) com campos adicionais (cargo e admissao)
model Membro {
  idUser   String @map("id_user")
  idProj   String @map("id_proj")
  cargo    String
  admissao DateTime

  // Configuração das chaves estrangeiras
  usuario  Usuario  @relation(fields: [idUser], references: [id])
  projeto  Projeto  @relation(fields: [idProj], references: [id])

  @@id([idUser, idProj]) // Chave primária composta (idUser + idProj) como você definiu
  @@map("membro")
}

model ProcessoSeletivo {
  id         String      @id @default(cuid())
  projetoId  String      @map("projeto")
  titulo     String
  descricao  String
  inscricao  String
  dataLimite DateTime @map("data_limite")
  postadoEm DateTime @default(now()) @map("postado_em")

  // Relação: Um Processo Seletivo pertence a um Projeto
  projeto    Projeto  @relation(fields: [projetoId], references: [id])

  @@map("processo_seletivo")
}

model Evento {
  id        String     @id @default(cuid())
  nome      String
  descricao String
  local     String
  data      DateTime
  horario   DateTime
  projetoId String      @map("projeto")

  // Relação: Um Evento pertence a um Projeto
  projeto   Projeto  @relation(fields: [projetoId], references: [id])

  @@map("evento")
}
